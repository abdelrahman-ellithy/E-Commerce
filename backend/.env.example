# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=5000
NODE_ENV=development

# ---------------------------------------------------------------------------
# Database
# Local MongoDB:  mongodb://127.0.0.1:27017/luma
# Atlas example:  mongodb+srv://<user>:<password>@<cluster>/luma?retryWrites=true&w=majority
# ---------------------------------------------------------------------------
MONGO_URI=mongodb://127.0.0.1:27017/luma

# ---------------------------------------------------------------------------
# Authentication
# Use a long, random value in production (32+ characters recommended).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ---------------------------------------------------------------------------
JWT_SECRET=replace-this-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=7d

# ---------------------------------------------------------------------------
# Client / CORS (comma-separated list is supported)
# ---------------------------------------------------------------------------
CLIENT_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Seed accounts (used by `npm run seed`)
# ---------------------------------------------------------------------------
SEED_ADMIN_NAME=Admin User
SEED_ADMIN_EMAIL=admin@luma.dev
SEED_ADMIN_PASSWORD=Admin123!
SEED_USER_NAME=Demo Customer
SEED_USER_EMAIL=demo@luma.dev
SEED_USER_PASSWORD=Demo123!
